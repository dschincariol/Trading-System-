DB_PATH=./data/trading.db
LIVE_PRICE_PROVIDER=polygon_ws
POLYGON_API_KEY=YOUR_REAL_POLYGON_KEY
POLYGON_WS_ENDPOINT=wss://socket.polygon.io/stocks
POLYGON_WS_SUBSCRIBE_TRADES=1
POLYGON_WS_SUBSCRIBE_QUOTES=1
OPTIONS_PROVIDER=polygon
JOB_OWNER=local
JOB_LOCK_STALE_AFTER_S=300
STREAM_PRICES_FLUSH_MS=250
STREAM_PRICES_HEARTBEAT_S=2.0
STREAM_PRICES_MIN_WRITE_INTERVAL_MS=250
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=101
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_API_TOKEN=
AUTO_BOOT_DAEMONS=false
AUTO_BOOT_TARGETS=stream_prices_polygon_ws
AUTO_PIPELINE=1
AUTO_PIPELINE_INCLUDE_EXECUTION=0
OPERATOR_AUTORESTART=true
OPERATOR_HEALTH_URL=http://127.0.0.1:8000/api/health
OPERATOR_MODE=safe
EXECUTION_MODE=safe
PREFLIGHT_BLOCK_JOBS=0
PREFLIGHT_ENABLE=1